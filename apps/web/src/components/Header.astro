---
import Logo from './Logo.astro';

interface Props {
  transparent?: boolean;
}

const { transparent = true } = Astro.props;
---

<header class={`site-header ${transparent ? 'site-header--trans' : 'site-header--solid'}`}>
  <div class="header-container">
    <!-- Brand Logo Modern Singgah -->
    <a href="/" class="header-brand">
      <Logo size="md" showTagline={true} />
    </a>

    <!-- Navigasi Tengah Modern -->
    <nav class="header-nav" aria-label="Navigasi Utama">
      <a href="/destinasi" class="nav-item">
        <span data-i18n="nav.destinasi">Destinasi</span>
      </a>
      <a href="/suasana" class="nav-item">
        <span data-i18n="nav.suasana">Suasana</span>
      </a>
      <a href="/rencana" class="nav-item">
        <span data-i18n="nav.rencana">Rencana Saya</span>
      </a>
      <a href="/catatan" class="nav-item">
        <span data-i18n="nav.catatan">Catatan</span>
      </a>
      <a href="/catatan-data" class="nav-item">
        <span data-i18n="nav.data">Tentang Data</span>
      </a>
    </nav>

    <!-- Header Actions (Zona Waktu/Bahasa & Pill CTA) -->
    <div class="header-actions">
      <!-- Language Switcher Dropdown (ID / EN) -->
      <div class="lang-switcher-wrapper">
        <button
          type="button"
          id="lang-toggle-btn"
          class="region-pill"
          aria-haspopup="true"
          aria-expanded="false"
          title="Pilih Bahasa / Select Language"
          aria-label="Pilih Bahasa / Language Selector"
        >
          <svg
            class="w-4 h-4 text-mint flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span id="header-lang-code" class="font-sans font-semibold text-sm text-white tracking-wide">ID</span>
          <svg class="region-chevron w-3.5 h-3.5 text-white/60 ml-0.5 flex-shrink-0" viewBox="0 0 16 16" fill="none">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>

        <!-- Floating Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="lang-dropdown-menu hidden"
          role="menu"
          aria-label="Pilihan Bahasa"
        >
          <button
            type="button"
            class="lang-select-item"
            data-lang="id"
            role="menuitem"
          >
            <span class="flag-indicator flag-id" aria-hidden="true">
              <span class="flag-top"></span>
              <span class="flag-bottom"></span>
            </span>
            <span class="lang-name">Bahasa Indonesia</span>
            <span class="lang-badge">ID</span>
          </button>
          <button
            type="button"
            class="lang-select-item"
            data-lang="en"
            role="menuitem"
          >
            <span class="flag-indicator flag-en" aria-hidden="true">
              <span class="flag-top"></span>
              <span class="flag-bottom"></span>
            </span>
            <span class="lang-name">English</span>
            <span class="lang-badge">EN</span>
          </button>
        </div>
      </div>

      <!-- Tombol Masuk & CTA Pill -->
      <a href="/masuk" class="login-link" data-i18n="nav.masuk">Masuk</a>
      <a href="/rencana/baru" class="cta-pill">
        <span data-i18n="nav.susun">Susun Rencana</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none">
          <path
            d="M4 10H16M16 10L11 5M16 10L11 15"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header--trans {
    background: linear-gradient(
      to bottom,
      rgba(4, 16, 23, 0.8) 0%,
      rgba(4, 16, 23, 0.4) 60%,
      transparent 100%
    );
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .site-header--solid {
    background: rgba(5, 19, 26, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--margin-x);
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .text-mint {
    color: var(--mint);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.14em;
    line-height: 1.1;
    color: #ffffff;
  }

  .brand-tagline {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 1px;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 32px;
  }

  @media (min-width: 960px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
  }

  .chevron {
    width: 11px;
    height: 11px;
    opacity: 0.6;
    transition: transform 0.2s ease;
  }

  .nav-item:hover .chevron {
    transform: translateY(1px);
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .region-pill {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    height: 42px;
    min-width: 84px;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .region-pill:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .region-chevron {
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
    display: inline-block;
    will-change: transform;
  }

  .region-pill:hover .region-chevron {
    color: var(--mint);
  }

  @media (min-width: 640px) {
    .region-pill {
      display: flex;
    }
  }

  /* Boxed Login Button (Frosted Glass Pill) */
  .login-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 8px 20px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .login-link:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .login-link:active {
    transform: translateY(0);
  }

  .cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--mint);
    color: #04141a;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 700;
    padding: 0 22px;
    height: 42px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(45, 212, 191, 0.38);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-pill:hover {
    background: #5eead4;
    transform: translateY(-2px);
    box-shadow: 0 6px 26px rgba(45, 212, 191, 0.55);
  }

  /* Language Switcher Dropdown Styles */
  .lang-switcher-wrapper {
    position: relative;
    display: none;
  }

  @media (min-width: 640px) {
    .lang-switcher-wrapper {
      display: block;
    }
  }

  .lang-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 220px;
    background: rgba(14, 25, 31, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 8px;
    box-shadow: 0 20px 48px -10px rgba(0, 0, 0, 0.75), 0 0 1px 1px rgba(255, 255, 255, 0.08);
    z-index: 120;
    display: flex;
    flex-direction: column;
    gap: 4px;
    animation: langDropdownIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang-dropdown-menu.hidden {
    display: none !important;
  }

  @keyframes langDropdownIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .lang-select-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 14px;
    border-radius: 12px;
    background: transparent;
    border: 1px solid transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 0.18s ease;
  }

  .lang-select-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .lang-select-item.active {
    background: rgba(45, 212, 191, 0.12);
    border-color: rgba(45, 212, 191, 0.35);
    color: #ffffff;
    font-weight: 600;
  }

  .lang-name {
    flex: 1;
  }

  .lang-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mint);
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(45, 212, 191, 0.14);
  }

  /* Micro Flags (Minimalist CSS, zero emoji) */
  .flag-indicator {
    width: 20px;
    height: 14px;
    border-radius: 3px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .flag-id .flag-top {
    height: 50%;
    background-color: #E11D48;
  }

  .flag-id .flag-bottom {
    height: 50%;
    background-color: #FFFFFF;
  }

  .flag-en {
    background-color: #1E3A8A;
    position: relative;
  }

  .flag-en .flag-top,
  .flag-en .flag-bottom {
    display: none;
  }

  .flag-en::before {
    content: '';
    position: absolute;
    left: 45%;
    top: 0;
    bottom: 0;
    width: 2.5px;
    background: #E11D48;
    box-shadow: 0 0 0 1px #FFFFFF;
  }

  .flag-en::after {
    content: '';
    position: absolute;
    top: 45%;
    left: 0;
    right: 0;
    height: 2.5px;
    background: #E11D48;
    box-shadow: 0 0 0 1px #FFFFFF;
  }

  /* Icon rotasi ketika menu aktif - Berbalik arah secara mulus (180deg) */
  button[aria-expanded="true"] .region-chevron,
  .region-pill.is-open .region-chevron {
    transform: rotate(180deg);
    color: var(--mint);
  }
</style>

<script>
  import { initLanguageSwitcher } from '../scripts/i18n';

  // Inisialisasi language switcher saat DOM siap
  initLanguageSwitcher();
  document.addEventListener('astro:page-load', () => {
    initLanguageSwitcher();
  });
</script>

---
const currentYear = 2026;
---

<footer class="site-footer tema-malam" aria-labelledby="footer-brand">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <span id="footer-brand" class="footer-brand">Singgah</span>
        <p class="footer-tagline">
          Panduan destinasi Nusantara berbasis kalender iklim 30 tahun dan penyusun rencana
          perjalanan.
        </p>
      </div>

      <nav class="footer-links-grid" aria-label="Tautan Footer">
        <div class="footer-col">
          <h2 class="footer-heading">Jelajah</h2>
          <ul>
            <li><a href="/destinasi">Destinasi</a></li>
            <li><a href="/suasana">Suasana</a></li>
            <li><a href="/catatan">Catatan lapangan</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Rencana</h2>
          <ul>
            <li><a href="/rencana/saran">Rencana Cepat</a></li>
            <li><a href="/rencana">Rencana saya</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Tentang</h2>
          <ul>
            <li><a href="/catatan-data">Catatan data</a></li>
            <li><a href="/atribusi">Atribusi</a></li>
            <li><a href="/privasi">Privasi</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-meta">
        Foto milik para fotografer yang tercantum di halaman Atribusi. Data cuaca dari Open-Meteo
        (CC BY 4.0). Dibuat tanpa iklan dan pelacak komersial.
      </p>
      <p class="footer-copy">
        &copy; {currentYear} Singgah.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg);
    color: var(--text);
    padding: 80px 0 40px;
    margin-top: auto;
    border-top: 1px solid var(--line);
  }

  .footer-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 var(--margin-x);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 3fr;
    }
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--text);
    display: block;
    margin-bottom: 12px;
  }

  .footer-tagline {
    font-size: var(--t-ui);
    color: var(--text-2);
    max-width: 360px;
    line-height: 1.6;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--t-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-3);
    margin-bottom: 16px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col a {
    color: var(--text-2);
    text-decoration: none;
    font-size: var(--t-ui);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 32px;
    font-size: var(--t-small);
    color: var(--text-3);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-meta {
    margin: 0;
    max-width: 680px;
  }

  .footer-copy {
    margin: 0;
  }
</style>

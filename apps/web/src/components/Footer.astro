---
import Logo from './Logo.astro';

const currentYear = 2026;
---

<footer class="site-footer" aria-labelledby="footer-brand">
  <div class="footer-container">
    <!-- Top Newsletter / Brand Banner -->
    <div class="footer-hero-strip">
      <div>
        <span class="text-xs uppercase tracking-[0.2em] text-mint font-semibold block mb-2">SINGGAH NUSANTARA</span>
        <h3 class="font-serif text-2xl md:text-3xl text-white">Menjelajah di saat alam sedang paling ramah</h3>
      </div>
      <div class="flex items-center gap-3">
        <a href="/destinasi" class="btn-glass text-xs py-2.5 px-5">Lihat 6 Destinasi</a>
        <a href="/rencana/baru" class="btn-primary text-xs py-2.5 px-6">Mulai Rencana</a>
      </div>
    </div>

    <div class="footer-top">
      <div class="footer-brand-col">
        <a href="/" class="mb-4 inline-flex">
          <Logo size="md" showTagline={true} />
        </a>
        <p class="footer-tagline">
          Platform kurasi destinasi Nusantara berbasis analisis data iklim historis 30 tahun (1994–2023) dari Open-Meteo. Memberikan rekomendasi jujur, tanpa opini sponsor.
        </p>
      </div>

      <nav class="footer-links-grid" aria-label="Tautan Footer">
        <div class="footer-col">
          <h4 class="footer-heading">Jelajah</h4>
          <ul>
            <li><a href="/destinasi">Semua Destinasi</a></li>
            <li><a href="/suasana">Kategori Suasana</a></li>
            <li><a href="/catatan">Catatan Lapangan</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Rencana</h4>
          <ul>
            <li><a href="/rencana/saran">Rekomendasi Cepat</a></li>
            <li><a href="/rencana/baru">Penyusun Rencana</a></li>
            <li><a href="/rencana">Rencana Saya</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Transparansi</h4>
          <ul>
            <li><a href="/catatan-data">Metodologi & Rumus</a></li>
            <li><a href="/atribusi">Kredit Fotografer</a></li>
            <li><a href="/privasi">Kebijakan Privasi</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom text-center">
      <p class="footer-copy">
        &copy; {currentYear} Singgah. Dibuat dengan cinta untuk keindahan alam Nusantara.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #030C11;
    color: var(--text);
    padding: 80px 0 40px;
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--margin-x);
  }

  .footer-hero-strip {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 48px;
    margin-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-hero-strip {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .text-mint {
    color: var(--mint);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1.8fr 3.2fr;
    }
  }

  .footer-tagline {
    font-size: 0.88rem;
    color: var(--text-2);
    max-width: 420px;
    line-height: 1.65;
    margin: 0;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 600px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mint);
    margin-bottom: 20px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-top: 36px;
    font-size: 0.82rem;
    color: var(--text-3);
    width: 100%;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }
  }

  .footer-copy {
    margin: 0 auto;
    text-align: center;
    width: 100%;
  }
</style>

---
interface Props {
  destinationSlug: string;
  destinationName: string;
}

const { destinationSlug, destinationName } = Astro.props;
---

<div
  class="weather-widget bg-surface rounded-panel border border-line p-6 md:p-8 relative min-h-[280px] flex flex-col justify-between"
  data-slug={destinationSlug}
  id={`weather-widget-${destinationSlug}`}>
  <!-- SKELETON LOADER (Ukuran sama persis untuk mencegah pergeseran tata letak / zero CLS) -->
  <div class="weather-skeleton animate-pulse flex flex-col justify-between h-full min-h-[220px]">
    <div>
      <div class="flex items-baseline gap-4 mb-3">
        <div class="h-16 w-28 bg-surface-2 rounded-ui"></div>
        <div class="h-6 w-36 bg-surface-2 rounded-ui"></div>
      </div>
      <div class="h-4 w-64 bg-surface-2 rounded-ui mb-6"></div>
    </div>
    <div class="grid grid-cols-7 gap-2 pt-4 border-t border-line">
      {
        Array.from({ length: 7 }).map(() => (
          <div class="flex flex-col items-center gap-2">
            <div class="h-3 w-6 bg-surface-2 rounded" />
            <div class="h-6 w-8 bg-surface-2 rounded" />
            <div class="h-8 w-2 bg-surface-2 rounded" />
          </div>
        ))
      }
    </div>
  </div>

  <!-- KONTEN CUACA RIIL (Diinjeksi saat API merespons) -->
  <div class="weather-content hidden flex-col justify-between h-full min-h-[220px]">
    <div>
      <div class="flex items-baseline gap-4 mb-1">
        <span class="weather-temp font-serif text-[clamp(3.5rem,7vw,5.5rem)] leading-none text-text"
          >--°</span
        >
        <span class="weather-condition font-serif text-2xl text-text">Memuat cuaca...</span>
      </div>
      <p class="weather-meta font-sans text-xs text-text-2 mb-6">
        Terasa <span class="weather-feels">--</span> °C • Angin <span class="weather-wind">--</span> km/jam
        • Peluang hujan <span class="weather-rain">--</span>%
      </p>
    </div>

    <!-- Prakiraan 7 Hari Berupa 7 Kolom Minimalis -->
    <div>
      <span class="text-[10px] uppercase tracking-wider text-text-3 font-semibold block mb-3">
        Prakiraan 7 Hari
      </span>
      <div
        class="weather-forecast-grid grid grid-cols-7 gap-2 text-center pt-2 border-t border-line">
        <!-- Kolom-kolom diisi oleh script client -->
      </div>
    </div>

    <!-- Atribusi & Waktu Pembaruan -->
    <div
      class="mt-6 pt-3 border-t border-line flex items-center justify-between text-[11px] text-text-3">
      <span
        >Data: <a
          href="https://open-meteo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link underline">Open-Meteo</a
        >, diperbarui <span class="weather-updated">--:--</span></span
      >
      <a
        href="https://www.bmkg.go.id"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-text underline">
        Cek BMKG Resmi
      </a>
    </div>
  </div>

  <!-- STATE GALAT (Fallback Lembut) -->
  <div
    class="weather-error hidden flex-col items-center justify-center text-center p-6 min-h-[220px]">
    <p class="font-sans text-sm text-text-2 mb-3">
      Data cuaca langsung belum bisa dimuat saat ini.
    </p>
    <div class="flex items-center gap-4 text-xs">
      <button
        type="button"
        class="btn-retry font-medium text-link underline hover:text-link-hover cursor-pointer">
        Coba lagi
      </button>
      <span class="text-text-3">•</span>
      <a
        href="https://www.bmkg.go.id"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-2 hover:text-text underline">
        Buka Prakiraan Cuaca BMKG
      </a>
    </div>
  </div>
</div>

<script>
  function initWeatherWidget() {
    const widgets = document.querySelectorAll<HTMLElement>('.weather-widget');

    widgets.forEach((widget) => {
      const slug = widget.dataset.slug;
      if (!slug) return;

      const skeleton = widget.querySelector<HTMLElement>('.weather-skeleton');
      const content = widget.querySelector<HTMLElement>('.weather-content');
      const errorBox = widget.querySelector<HTMLElement>('.weather-error');
      const retryBtn = widget.querySelector<HTMLButtonElement>('.btn-retry');

      async function fetchWeather() {
        if (!skeleton || !content || !errorBox) return;

        skeleton.classList.remove('hidden');
        content.classList.add('hidden');
        content.classList.remove('flex');
        errorBox.classList.add('hidden');
        errorBox.classList.remove('flex');

        try {
          // Panggil API Worker lokal atau fallback Open-Meteo langsung jika dev
          const res = await fetch(`/api/v1/weather/${slug}`).catch(() => null);
          let data: any = null;

          if (res && res.ok) {
            data = await res.json();
          } else {
            // Client-side direct fallback ke Open-Meteo jika Worker belum menyala saat preview
            const coords: Record<string, { lat: number; lon: number }> = {
              'labuan-bajo': { lat: -8.4964, lon: 119.8877 },
              bromo: { lat: -7.9425, lon: 112.953 },
              'banda-neira': { lat: -4.5256, lon: 129.9042 },
              yogyakarta: { lat: -7.7956, lon: 110.3695 },
              'danau-toba': { lat: 2.6845, lon: 98.8756 },
              toraja: { lat: -3.1042, lon: 119.8631 },
            };
            const c = coords[slug];
            if (c) {
              const omRes = await fetch(
                `https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&current=temperature_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days=7`,
              );
              if (omRes.ok) {
                const omJson = await omRes.json();
                const dayNames = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
                data = {
                  temperature_c: Math.round(omJson.current?.temperature_2m ?? 28),
                  feels_like_c: Math.round(omJson.current?.apparent_temperature ?? 30),
                  condition: 'Cerah berawan',
                  wind_kmh: Math.round(omJson.current?.wind_speed_10m ?? 10),
                  rain_probability: Math.round(
                    omJson.daily?.precipitation_probability_max?.[0] ?? 10,
                  ),
                  updated_at:
                    new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) +
                    ' WIB',
                  forecast_7d: (omJson.daily?.time || []).map((t: string, i: number) => ({
                    date: t,
                    day_label: dayNames[new Date(t).getDay()],
                    tmax_c: Math.round(omJson.daily.temperature_2m_max[i] ?? 30),
                    tmin_c: Math.round(omJson.daily.temperature_2m_min[i] ?? 24),
                    precipitation_probability: Math.round(
                      omJson.daily.precipitation_probability_max[i] ?? 10,
                    ),
                    condition: 'Cerah',
                  })),
                };
              }
            }
          }

          if (!data) throw new Error('Cuaca tidak dapat diakses.');

          // Render Data
          const tempEl = widget.querySelector<HTMLElement>('.weather-temp');
          const condEl = widget.querySelector<HTMLElement>('.weather-condition');
          const feelsEl = widget.querySelector<HTMLElement>('.weather-feels');
          const windEl = widget.querySelector<HTMLElement>('.weather-wind');
          const rainEl = widget.querySelector<HTMLElement>('.weather-rain');
          const updatedEl = widget.querySelector<HTMLElement>('.weather-updated');
          const forecastGrid = widget.querySelector<HTMLElement>('.weather-forecast-grid');

          if (tempEl) tempEl.textContent = `${data.temperature_c}°`;
          if (condEl) condEl.textContent = data.condition;
          if (feelsEl) feelsEl.textContent = data.feels_like_c;
          if (windEl) windEl.textContent = data.wind_kmh;
          if (rainEl) rainEl.textContent = data.rain_probability;
          if (updatedEl) updatedEl.textContent = data.updated_at;

          if (forecastGrid && Array.isArray(data.forecast_7d)) {
            forecastGrid.innerHTML = data.forecast_7d
              .map(
                (f: any) => `
                <div class="flex flex-col items-center gap-1 font-sans">
                  <span class="text-[11px] text-text-3 font-medium">${f.day_label}</span>
                  <span class="text-xs font-semibold text-text">${f.tmax_c}°</span>
                  <span class="text-[10px] text-text-3">${f.tmin_c}°</span>
                  <div class="w-full bg-surface-2 h-1 rounded-full mt-1 overflow-hidden" title="Peluang hujan ${f.precipitation_probability}%">
                    <div class="bg-link h-full" style="width: ${f.precipitation_probability}%"></div>
                  </div>
                </div>
              `,
              )
              .join('');
          }

          skeleton.classList.add('hidden');
          content.classList.remove('hidden');
          content.classList.add('flex');
        } catch {
          skeleton.classList.add('hidden');
          errorBox.classList.remove('hidden');
          errorBox.classList.add('flex');
        }
      }

      fetchWeather();
      if (retryBtn) {
        retryBtn.addEventListener('click', fetchWeather);
      }
    });
  }

  // Jalankan saat halaman siap
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWeatherWidget);
  } else {
    initWeatherWidget();
  }
</script>

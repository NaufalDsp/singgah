---
import type { ScoredMonth } from '@singgah/scoring';

interface Props {
  months: ScoredMonth[];
  mode?: 'ringkas' | 'penuh';
  destinationName?: string;
  selectedMonth?: number;
  class?: string;
}

const {
  months,
  mode = 'penuh',
  destinationName = 'Destinasi',
  selectedMonth,
  class: className = '',
} = Astro.props;

const monthNamesShort = [
  'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
  'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des',
];
const monthNamesFull = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember',
];
const currentMonthNumber = new Date().getMonth() + 1;

// Level mapping to height percent and numeric level
const levelMap: Record<string, { lvl: number; pct: string; label: string }> = {
  kurang: { lvl: 1, pct: '28%', label: 'Kurang' },
  cukup: { lvl: 2, pct: '52%', label: 'Cukup' },
  baik: { lvl: 3, pct: '78%', label: 'Baik' },
  'sangat-baik': { lvl: 4, pct: '100%', label: 'Sangat baik' },
};

// Summary accessible text
const bestMonths = months
  .filter((m) => m.level === 'sangat-baik' || m.level === 'baik')
  .map((m) => monthNamesShort[m.month - 1])
  .join(', ');
const poorMonths = months
  .filter((m) => m.level === 'kurang')
  .map((m) => monthNamesShort[m.month - 1])
  .join(', ');
const accessibleSummary = `Kalender musim ${destinationName}. Periode terbaik: ${bestMonths || '-'}. Periode kurang: ${poorMonths || '-'}.`;
---

<div
  class={`season-strip-wrapper ${mode === 'ringkas' ? 'season-strip--compact' : 'season-strip--full'} ${className}`}>
  <!-- Aksesibilitas: Teks untuk pembaca layar -->
  <span class="sr-only">{accessibleSummary}</span>

  <div
    class="season-strip-grid"
    role="region"
    aria-label={`Grafik musim 12 bulan ${destinationName}`}>
    {
      months.map((m) => {
        const meta = levelMap[m.level] ?? levelMap['kurang'];
        const isCurrent = m.month === currentMonthNumber;
        const isSelected = selectedMonth === m.month;
        const shortName = monthNamesShort[m.month - 1];
        const fullName = monthNamesFull[m.month - 1];
        const tooltipText = `${fullName}: ${meta.label}. Curah hujan ${Math.round(m.precip_mm)} mm, ${Math.round(m.wet_days)} hari hujan, ${m.tmax_c.toFixed(1)} °C.${m.is_override ? ` Catatan: ${m.override_reason}` : ''}`;

        return (
          <div class="season-bar-col">
            {/* Titik indikator penimpaan (override) */}
            {mode === 'penuh' && m.is_override && (
              <span
                class="season-override-dot"
                title={`Koreksi manual: ${m.override_reason}`}
                aria-hidden="true"
              />
            )}

            <div
              class={`season-bar ${isCurrent ? 'season-bar--current' : ''} ${isSelected ? 'season-bar--selected' : ''}`}
              data-lvl={meta.lvl}
              style={`--lvl-h: ${meta.pct};`}
              title={tooltipText}
              tabindex="0"
              role="button"
              aria-label={tooltipText}
            />

            {mode === 'penuh' && (
              <span class={`season-month-label ${isCurrent ? 'season-month-label--current' : ''}`}>
                {shortName}
              </span>
            )}
          </div>
        );
      })
    }
  </div>

  {
    mode === 'penuh' && (
      <details class="season-details-table">
        <summary class="season-details-summary">Lihat rincian angka lengkap 12 bulan</summary>
        <div class="season-table-wrap">
          <table class="season-table">
            <thead>
              <tr>
                <th>Bulan</th>
                <th>Status</th>
                <th>Curah Hujan</th>
                <th>Hari Hujan</th>
                <th>Suhu Maks</th>
              </tr>
            </thead>
            <tbody>
              {months.map((m) => {
                const meta = levelMap[m.level] ?? levelMap['kurang'];
                return (
                  <tr>
                    <td class="font-semibold text-white">{monthNamesFull[m.month - 1]}</td>
                    <td>
                      <span class={`level-badge level-badge--${m.level}`}>{meta.label}</span>
                      {m.is_override && <span class="override-tag">* Koreksi lokal</span>}
                    </td>
                    <td>{Math.round(m.precip_mm)} mm</td>
                    <td>{Math.round(m.wet_days)} hari</td>
                    <td>{m.tmax_c.toFixed(1)} °C</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</div>

<style>
  .season-strip-wrapper {
    width: 100%;
  }

  .season-strip-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
  }

  .season-strip--compact .season-strip-grid {
    height: 32px;
    gap: 3px;
  }

  .season-strip--full .season-strip-grid {
    height: 150px;
    gap: 6px;
  }

  .season-bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    position: relative;
  }

  .season-bar {
    width: 100%;
    height: var(--lvl-h);
    min-height: 8px;
    border-radius: 6px 6px 2px 2px;
    cursor: pointer;
    transform-origin: bottom;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .season-bar:hover,
  .season-bar:focus-visible {
    transform: scaleY(1.06);
    filter: brightness(1.2);
  }

  .season-bar[data-lvl='1'] {
    background-color: var(--musim-1);
    opacity: 0.6;
  }
  .season-bar[data-lvl='2'] {
    background-color: var(--musim-2);
  }
  .season-bar[data-lvl='3'] {
    background-color: var(--musim-3);
  }
  .season-bar[data-lvl='4'] {
    background-color: var(--musim-4);
    box-shadow: 0 0 12px rgba(94, 234, 212, 0.4);
  }

  .season-bar--current {
    box-shadow:
      0 0 0 2px var(--mint),
      0 0 16px rgba(45, 212, 191, 0.6) !important;
  }

  .season-bar--selected {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .season-override-dot {
    position: absolute;
    top: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--warn);
  }

  .season-month-label {
    font-size: 0.72rem;
    color: var(--text-3);
    margin-top: 10px;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .season-month-label--current {
    color: #ffffff;
    font-weight: 700;
    position: relative;
  }

  .season-month-label--current::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--mint);
  }

  /* Details table */
  .season-details-table {
    margin-top: 20px;
    font-size: 0.8rem;
  }

  .season-details-summary {
    cursor: pointer;
    color: var(--mint);
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .season-details-summary:hover {
    opacity: 0.8;
  }

  .season-table-wrap {
    overflow-x: auto;
    margin-top: 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .season-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    text-align: left;
    background: rgba(0, 0, 0, 0.25);
  }

  .season-table th,
  .season-table td {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .season-table th {
    color: var(--text-3);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .level-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .level-badge--sangat-baik {
    background: rgba(52, 211, 153, 0.15);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .level-badge--baik {
    background: rgba(45, 212, 191, 0.15);
    color: #2DD4BF;
    border: 1px solid rgba(45, 212, 191, 0.3);
  }
  .level-badge--cukup {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-2);
  }
  .level-badge--kurang {
    background: rgba(245, 158, 11, 0.15);
    color: #FBBF24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .override-tag {
    font-size: 0.7rem;
    color: var(--warn);
    margin-left: 6px;
  }
</style>

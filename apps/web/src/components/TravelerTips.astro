---
interface Props {
  destinationSlug: string;
  destinationName: string;
}

const { destinationSlug, destinationName } = Astro.props;

const monthNames = [
  'Januari',
  'Februari',
  'Maret',
  'April',
  'Mei',
  'Juni',
  'Juli',
  'Agustus',
  'September',
  'Oktober',
  'November',
  'Desember',
];
---

<section
  id="traveler-tips-section"
  class="traveler-tips-box bg-[#081822] rounded-3xl border border-white/10 p-6 md:p-8 shadow-xl"
  data-slug={destinationSlug}
  data-name={destinationName}>
  <div
    class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-6 pb-4 border-b border-white/8">
    <div>
      <h3 class="font-serif text-2xl md:text-3xl text-white">Tips dari pelancong</h3>
      <p class="font-sans text-xs text-text-3 mt-1">
        Pengalaman faktual dari mereka yang pernah singgah di {destinationName}. Dimoderasi secara objektif.
      </p>
    </div>
    <span class="tips-count text-xs font-sans text-mint font-semibold"></span>
  </div>

  <!-- DAFTAR TIPS PUBLIK -->
  <div class="tips-list space-y-4 mb-8">
    <div class="tips-loading text-xs font-sans text-text-3 italic py-4 text-center">
      Memeriksa catatan pelancong...
    </div>
  </div>

  <!-- FORMULIR TULIS TIP -->
  <div class="tip-form-container pt-6 border-t border-white/8">
    <div class="tip-form-auth-gate hidden">
      <div
        class="p-4 bg-black/30 rounded-2xl border border-white/8 text-xs font-sans flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="text-text-2">
          Punya catatan praktis tentang logistik atau rute di {destinationName}? Masuk akun untuk membagikan tip.
        </p>
        <a href="/masuk" class="btn-glass text-xs h-8 px-4 whitespace-nowrap"> Masuk akun </a>
      </div>
    </div>

    <form class="tip-form hidden space-y-4" method="post">
      <div>
        <label for="tip-body" class="text-xs font-sans font-semibold text-text-3 block mb-1.5">
          Tulis Tip Perjalanan (20–400 karakter, teks polos):
        </label>
        <textarea
          id="tip-body"
          name="body"
          rows="3"
          minlength="20"
          maxlength="400"
          placeholder="Contoh: Bawa uang tunai secukupnya karena mesin ATM pelabuhan sering antre atau gangguan sinyal saat akhir pekan."
          required
          class="w-full bg-[#041017] border border-white/10 rounded-2xl p-3.5 text-xs md:text-sm font-sans text-white outline-none focus:border-mint"
        ></textarea>
        <div class="flex justify-between items-center text-[11px] text-text-3 mt-1">
          <span>Hanya teks informatif. Tanpa promosi komersial atau spam.</span>
          <span class="char-counter text-mint font-mono">0 / 400</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs font-sans">
          <label for="tip-month" class="text-text-3 whitespace-nowrap font-medium">Bulan berkunjung:</label>
          <select
            id="tip-month"
            name="visited_month"
            class="bg-[#041017] border border-white/10 rounded-xl px-3 py-1.5 text-xs text-white outline-none focus:border-mint cursor-pointer">
            <option value="" class="bg-[#081822]">Tidak ditentukan</option>
            {monthNames.map((m, idx) => <option value={idx + 1} class="bg-[#081822]">{m}</option>)}
          </select>
        </div>

        <button type="submit" class="btn-primary text-xs h-10 px-5">
          Kirim Tip untuk Dimoderasi
        </button>
      </div>

      <div class="tip-form-msg hidden text-xs font-sans p-3 rounded-xl"></div>
    </form>
  </div>
</section>

<script>
  function initTravelerTips() {
    const section = document.getElementById('traveler-tips-section');
    if (!section) return;

    const slug = section.dataset.slug;
    const listEl = section.querySelector<HTMLElement>('.tips-list');
    const countEl = section.querySelector<HTMLElement>('.tips-count');
    const authGate = section.querySelector<HTMLElement>('.tip-form-auth-gate');
    const form = section.querySelector<HTMLFormElement>('.tip-form');
    const textarea = section.querySelector<HTMLTextAreaElement>('#tip-body');
    const charCounter = section.querySelector<HTMLElement>('.char-counter');
    const msgEl = section.querySelector<HTMLElement>('.tip-form-msg');

    const monthNames = [
      'Januari',
      'Februari',
      'Maret',
      'April',
      'Mei',
      'Juni',
      'Juli',
      'Agustus',
      'September',
      'Oktober',
      'November',
      'Desember',
    ];

    fetch('/api/v1/auth/me')
      .then((res) => {
        if (res.ok) {
          form?.classList.remove('hidden');
          authGate?.classList.add('hidden');
        } else {
          form?.classList.add('hidden');
          authGate?.classList.remove('hidden');
        }
      })
      .catch(() => {
        form?.classList.add('hidden');
        authGate?.classList.remove('hidden');
      });

    textarea?.addEventListener('input', () => {
      if (charCounter && textarea) {
        charCounter.textContent = `${textarea.value.length} / 400`;
      }
    });

    async function loadTips() {
      if (!listEl) return;
      try {
        const res = await fetch(`/api/v1/destinations/${slug}/tips`);
        if (!res.ok) throw new Error('Gagal memuat tips');

        const data = await res.json();
        const tips = data.tips || [];

        if (countEl) {
          countEl.textContent = `${tips.length} tip komunitas`;
        }

        if (tips.length === 0) {
          listEl.innerHTML = `
            <div class="py-6 text-center text-xs font-sans text-text-3">
              Belum ada tip tersimpan untuk tempat ini. Pernah singgah ke sini? Bagikan catatanmu melalui formulir di bawah.
            </div>
          `;
          return;
        }

        listEl.innerHTML = tips
          .map((t: any) => {
            const visitedText = t.visited_month
              ? ` • Dikunjungi bulan ${monthNames[t.visited_month - 1]}`
              : '';
            return `
              <div class="p-4 bg-black/30 rounded-2xl border border-white/8 flex flex-col justify-between gap-3">
                <p class="font-sans text-xs sm:text-sm text-white/90 leading-relaxed">
                  "${t.body}"
                </p>
                <div class="flex items-center justify-between text-xs font-sans text-text-3 pt-2 border-t border-white/8">
                  <span>
                    <strong class="text-white">${t.author?.name || 'Pelancong'}</strong>${visitedText}
                  </span>
                  <button
                    type="button"
                    class="btn-report text-xs text-text-3 hover:text-red-400 underline"
                    data-tip-id="${t.id}"
                  >
                    Laporkan
                  </button>
                </div>
              </div>
            `;
          })
          .join('');

        listEl.querySelectorAll<HTMLButtonElement>('.btn-report').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const tipId = btn.dataset.tipId;
            const reason = prompt(
              'Masukkan alasan pelaporan (misal: spam, promosi, atau info tidak akurat):',
            );
            if (!reason) return;

            try {
              const repRes = await fetch(`/api/v1/tips/${tipId}/report`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason }),
              });

              if (repRes.ok) {
                alert('Laporan berhasil dikirim dan akan segera ditinjau oleh tim moderator.');
              } else {
                const repErr = await repRes.json();
                alert(
                  repErr.error?.message ||
                    'Gagal mengirim laporan. Pastikan kamu sudah masuk akun.',
                );
              }
            } catch {
              alert('Terjadi kesalahan koneksi.');
            }
          });
        });
      } catch {
        listEl.innerHTML = `
          <div class="py-4 text-center text-xs font-sans text-text-3">
            Tips belum dapat dimuat saat ini.
          </div>
        `;
      }
    }

    loadTips();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!textarea || !msgEl) return;

      const bodyText = textarea.value.trim();
      const monthVal = (form.querySelector('#tip-month') as HTMLSelectElement)?.value;
      const visitedMonth = monthVal ? parseInt(monthVal) : null;

      msgEl.classList.remove('hidden', 'bg-emerald-500/20', 'text-emerald-300', 'bg-rose-500/20', 'text-rose-300');
      msgEl.textContent = 'Mengirim tip...';

      try {
        const res = await fetch(`/api/v1/destinations/${slug}/tips`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            body: bodyText,
            visited_month: visitedMonth,
          }),
        });

        const json = await res.json();
        if (res.ok) {
          msgEl.className = 'tip-form-msg text-xs font-sans p-3 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          msgEl.textContent =
            'Tip berhasil dikirim! Catatan akan ditinjau moderator sebelum tayang.';
          textarea.value = '';
          if (charCounter) charCounter.textContent = '0 / 400';
        } else {
          msgEl.className = 'tip-form-msg text-xs font-sans p-3 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/30';
          msgEl.textContent = json.error?.message || 'Gagal mengirim tip.';
        }
      } catch {
        msgEl.className = 'tip-form-msg text-xs font-sans p-3 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/30';
        msgEl.textContent = 'Terjadi kesalahan sistem saat mengirim tip.';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTravelerTips);
  } else {
    initTravelerTips();
  }
</script>

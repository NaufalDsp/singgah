---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Akun Pengguna — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-20 w-full">
    <div id="account-view" class="max-w-2xl mx-auto space-y-10">
      <!-- Loading Skeleton -->
      <div class="p-8 bg-[#081822] rounded-3xl border border-white/10 animate-pulse shadow-xl">
        <div class="h-16 w-16 bg-white/10 rounded-full mb-4"></div>
        <div class="h-6 w-48 bg-white/10 rounded mb-2"></div>
        <div class="h-4 w-32 bg-white/10 rounded"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  async function loadAccount() {
    const root = document.getElementById('account-view');
    if (!root) return;

    try {
      const res = await fetch('/api/v1/auth/me');
      if (!res.ok) {
        // Belum login
        root.innerHTML = `
          <div class="p-12 bg-[#081822] rounded-3xl border border-white/10 text-center shadow-2xl">
            <h1 class="font-serif text-3xl text-white mb-2">Kamu belum masuk</h1>
            <p class="font-sans text-sm text-text-2 mb-6">
              Masuk akun untuk menyinkronkan rencana perjalanan dan menyimpan destinasi favorit ke cloud.
            </p>
            <a href="/masuk" class="btn-primary text-xs">Masuk sekarang →</a>
          </div>
        `;
        return;
      }

      const data = await res.json();
      const user = data.user;

      root.innerHTML = `
        <div class="p-6 md:p-8 bg-[#081822] rounded-3xl border border-white/10 shadow-2xl">
          <div class="flex items-center gap-5 pb-6 border-b border-white/8 mb-6">
            <img
              src="${user.avatar_url || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80'}"
              alt="${user.name}"
              class="w-16 h-16 rounded-full object-cover border border-white/10"
            />
            <div>
              <span class="text-xs uppercase tracking-wider text-mint font-semibold block mb-0.5">
                Akun Terverifikasi (${user.role})
              </span>
              <h1 class="font-serif text-3xl text-white">${user.name}</h1>
              <span class="text-xs text-text-3 font-mono">ID: ${user.id}</span>
            </div>
          </div>

          <div class="space-y-4 font-sans text-sm">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-4 bg-black/30 rounded-2xl border border-white/6">
              <div>
                <strong class="text-white block font-semibold">Rencana Tersimpan</strong>
                <span class="text-xs text-text-3">Kelola atau bagikan rencana liburanmu</span>
              </div>
              <a href="/rencana" class="btn-primary text-xs h-9 px-4">
                Buka rencana saya
              </a>
            </div>

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-4 bg-black/30 rounded-2xl border border-white/6">
              <div>
                <strong class="text-white block font-semibold">Portabilitas Data (UU PDP)</strong>
                <span class="text-xs text-text-3">Unduh salinan seluruh data profil, rencana, dan tips</span>
              </div>
              <a href="/api/v1/auth/me/export" target="_blank" class="btn-glass text-xs h-9 px-4">
                Ekspor JSON
              </a>
            </div>

            <div class="flex items-center justify-between pt-6 border-t border-white/8">
              <a href="/api/v1/auth/logout" class="text-xs text-red-400 hover:text-red-300 font-semibold underline">
                Keluar dari akun
              </a>
            </div>
          </div>
        </div>
      `;
    } catch {
      // Offline fallback
    }
  }

  loadAccount();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Rencana Saya — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-16 w-full">
    <div class="max-w-3xl mb-12">
      <h1 class="font-serif text-[clamp(2.5rem,5vw,4.5rem)] text-text leading-tight mb-3">
        Rencana saya
      </h1>
      <p class="font-sans text-base text-text-2 leading-relaxed">
        Kelola rencana perjalanan yang telah kamu susun. Rencana tersimpan di perangkat ini dan
        disinkronkan saat kamu masuk akun.
      </p>
    </div>

    <!-- Container Rencana dari LocalStorage / Server -->
    <div id="user-trips-container" class="space-y-6">
      <div class="p-8 bg-surface rounded-panel border border-line text-center">
        <h2 class="font-serif text-2xl text-text mb-2">Memeriksa rencana tersimpan...</h2>
        <p class="font-sans text-sm text-text-2 mb-6">
          Memuat riwayat rencana perjalanan di perangkat ini.
        </p>
        <a href="/rencana/baru" class="btn-utama text-xs"> + Susun rencana baru </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function loadUserTrips() {
    const container = document.getElementById('user-trips-container');
    if (!container) return;

    try {
      const localData = localStorage.getItem('singgah_active_trip');
      if (localData) {
        const trip = JSON.parse(localData);
        container.innerHTML = `
          <div class="p-6 bg-surface rounded-panel border border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-sm">
            <div>
              <span class="text-xs uppercase tracking-wider text-text-3 font-semibold block mb-1">
                Tersimpan di Perangkat Ini
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl text-text mb-1">
                ${trip.title || 'Rencana Perjalanan'}
              </h2>
              <p class="font-sans text-xs text-text-2">
                Destinasi: <strong class="capitalize">${trip.destination}</strong> • Durasi: <strong>${trip.days} hari</strong> • ${trip.items?.length || 0} aktivitas
              </p>
            </div>

            <div class="flex items-center gap-3">
              <a href="/rencana/baru" class="btn-utama text-xs h-10 px-4">
                Buka & edit
              </a>
              <button id="btn-delete-local" class="btn-sekunder text-xs h-10 px-4 text-error">
                Hapus
              </button>
            </div>
          </div>

          <div class="text-center pt-8">
            <a href="/rencana/baru" class="text-xs text-link underline hover:text-link-hover">
              + Buat rencana baru lainnya
            </a>
          </div>
        `;

        document.getElementById('btn-delete-local')?.addEventListener('click', () => {
          if (confirm('Hapus rencana perjalanan tersimpan ini dari perangkat?')) {
            localStorage.removeItem('singgah_active_trip');
            loadUserTrips();
          }
        });
        return;
      }
    } catch {
      // Abaikan jika error membaca storage
    }

    // State Kosong
    container.innerHTML = `
      <div class="p-12 bg-surface rounded-panel border border-line text-center max-w-xl mx-auto">
        <h2 class="font-serif text-2xl text-text mb-2">Belum ada rencana perjalanan</h2>
        <p class="font-sans text-sm text-text-2 mb-6 leading-relaxed">
          Mulai susun rencana perjalanan dari rekomendasi Rencana Cepat atau pilih salah satu destinasi Nusantara.
        </p>
        <div class="flex justify-center gap-4">
          <a href="/rencana/baru" class="btn-utama text-xs">
            Susun rencana sekarang
          </a>
          <a href="/destinasi" class="btn-sekunder text-xs">
            Jelajahi destinasi
          </a>
        </div>
      </div>
    `;
  }

  loadUserTrips();
</script>

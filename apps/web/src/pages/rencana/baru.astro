---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripPlanner from '../../islands/TripPlanner';
import { getCollection, type CollectionEntry } from 'astro:content';

const destinations = await getCollection('destinations');
const destinationOptions = destinations.map((d: CollectionEntry<'destinations'>) => ({
  slug: d.slug,
  name: d.data.name,
  typical_days: d.data.typical_days,
  highlights: d.data.highlights,
}));

const searchParams = Astro.url.searchParams;
const destParam = searchParams.get('destinasi') || 'labuan-bajo';
const targetDest =
  destinations.find((d: CollectionEntry<'destinations'>) => d.slug === destParam) ||
  destinations[0];
---

<BaseLayout title="Penyusun Rencana Perjalanan — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-16 w-full">
    <div class="mb-10">
      <a
        href="/destinasi"
        class="text-xs font-sans font-medium text-mint hover:underline mb-3 inline-flex items-center gap-1.5">
        ← Kembali ke destinasi
      </a>
      <div class="flex items-center gap-2 text-mint text-xs uppercase tracking-widest font-semibold mb-2">
        <span class="w-2 h-2 rounded-full bg-mint"></span>
        <span>INTERAKTIF ITINERARI</span>
      </div>
      <h1 class="font-serif text-[clamp(2.4rem,4.5vw,4rem)] text-white leading-tight">
        Penyusun rencana perjalanan
      </h1>
      <p class="font-sans text-base text-text-2 mt-2">
        Atur urutan harian, seimbangkan beban aktivitas secara realistis, dan bagikan rencana ke teman seperjalanan.
      </p>
    </div>

    <!-- Island React Penyusun Rencana -->
    <TripPlanner
      client:load
      initialTrip={{
        title: `Rencana Singgah di ${targetDest?.data.name || 'Nusantara'}`,
        destination: targetDest?.slug || 'labuan-bajo',
        days: targetDest?.data.typical_days.min || 4,
        start_month: new Date().getMonth() + 1,
      }}
      destinations={destinationOptions}
    />
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeasonStrip from '../../components/SeasonStrip.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { calculateYearSeasons } from '@singgah/scoring';
import { getClimateData } from '../../utils/climate';

type DestEntry = CollectionEntry<'destinations'>;

const destinations: DestEntry[] = await getCollection('destinations');

// Load climate data
const climateDataMap: Record<string, any> = {};
for (const dest of destinations) {
  const data = getClimateData(dest.slug);
  if (data) {
    climateDataMap[dest.slug] = data;
  }
}

interface DestinationCard {
  dest: DestEntry;
  yearSeasons: any[];
}

const destinationCards: DestinationCard[] = destinations.map((dest) => {
  const climate = climateDataMap[dest.slug];
  const yearSeasons = climate
    ? calculateYearSeasons(climate.months, dest.data.profile, dest.data.season_overrides)
    : [];
  return {
    dest,
    yearSeasons,
  };
});

const islands = Array.from(new Set(destinations.map((d) => d.data.region.island)));

const ratings: Record<string, string> = {
  'labuan-bajo': '4.9',
  'banda-neira': '4.9',
  'danau-toba': '4.8',
  'bromo': '4.8',
  'toraja': '4.8',
  'yogyakarta': '4.7',
};

const optImg = (url: string, w = 640, q = 75) => {
  if (!url) return '';
  return url.includes('unsplash.com') ? `${url.split('?')[0]}?auto=format&fit=crop&w=${w}&q=${q}` : url;
};
---

<BaseLayout title="Daftar Destinasi Nusantara — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-20 w-full">
    <!-- Header Halaman Mewah -->
    <div class="max-w-3xl mb-14">
      <div class="flex items-center gap-2 text-mint text-xs uppercase tracking-widest font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-mint"></span>
        <span>KURASI DESTINASI NUSANTARA</span>
      </div>
      <h1 class="font-serif text-[clamp(2.5rem,5.5vw,5rem)] text-white leading-tight mb-4">
        Destinasi yang layak disinggahi
      </h1>
      <p class="font-sans text-base sm:text-lg text-text-2 leading-relaxed">
        Seluruh destinasi diverifikasi dengan sumber primer tertaut, estimasi waktu tempuh realistis, dan kalender musim dari analisis 30 tahun data iklim Open-Meteo.
      </p>
    </div>

    <!-- Filter Bar Glassmorphic -->
    <div class="py-4 px-6 rounded-2xl bg-[#081822] border border-white/10 flex flex-wrap items-center justify-between gap-4 mb-14 shadow-lg">
      <div class="flex flex-wrap items-center gap-2 text-xs font-sans font-medium">
        <span class="text-text-3 font-semibold uppercase tracking-wider mr-2">Kepulauan:</span>
        <a href="/destinasi" class="px-4 py-2 bg-mint text-black font-bold rounded-full shadow-sm transition-all">
          Semua Wilayah
        </a>
        {
          islands.map((island) => (
            <span class="px-4 py-2 rounded-full bg-white/[0.05] border border-white/8 text-white/80 hover:text-white hover:bg-white/10 cursor-pointer transition-colors">
              {island}
            </span>
          ))
        }
      </div>

      <div class="text-xs text-mint font-semibold bg-mint/10 border border-mint/20 px-3.5 py-1.5 rounded-full font-sans">
        {destinations.length} Destinasi Terpilih
      </div>
    </div>

    <!-- Grid Destinasi Premium -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        destinationCards.map(({ dest, yearSeasons }) => (
          <article class="bg-[#081822] rounded-3xl border border-white/10 overflow-hidden flex flex-col justify-between group hover:border-mint/50 transition-all duration-300 shadow-xl hover:-translate-y-1">
            <div>
              <a
                href={`/destinasi/${dest.slug}`}
                class="block aspect-[16/10] overflow-hidden relative">
                <img
                  src={optImg(dest.data.hero.photo, 640)}
                  alt={dest.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#081822] via-[#081822]/30 to-transparent"></div>
                
                <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md border border-white/12 px-3 py-1 rounded-full text-[11px] font-semibold text-white">
                  {dest.data.region.island}
                </div>

                <div class="absolute top-4 right-4 bg-black/60 backdrop-blur-md border border-white/12 px-2.5 py-1 rounded-full text-xs font-bold text-amber-400 flex items-center gap-1">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <span>{ratings[dest.slug] || '4.8'}</span>
                </div>
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-text-3 font-medium mb-1.5">
                  <span class="text-white/60">{dest.data.region.province}</span>
                  <span class="text-mint font-semibold">
                    {dest.data.typical_days.min}–{dest.data.typical_days.max} Hari
                  </span>
                </div>

                <h2 class="font-serif text-2xl sm:text-3xl text-white mb-2 group-hover:text-mint transition-colors">
                  <a href={`/destinasi/${dest.slug}`}>
                    {dest.data.name}
                  </a>
                </h2>

                <p class="font-sans text-xs sm:text-sm text-text-2 line-clamp-3 leading-relaxed mb-6">
                  {dest.data.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-3 border-t border-white/8 bg-black/20">
              <div class="flex items-center justify-between mb-2.5">
                <span class="text-[10px] text-text-3 font-semibold uppercase tracking-wider block">
                  Kalender Musim 12 Bulan
                </span>
                <span class="text-[10px] text-mint font-medium">Data 30 Tahun</span>
              </div>
              <SeasonStrip months={yearSeasons} mode="ringkas" destinationName={dest.data.name} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

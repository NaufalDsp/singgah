---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Masuk Akun — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-24 w-full flex items-center justify-center min-h-[75vh]">
    <div
      class="max-w-md w-full bg-[#081822] p-8 md:p-10 rounded-3xl border border-white/10 shadow-2xl text-center relative overflow-hidden">
      <!-- Glow ambient -->
      <div class="absolute -top-16 -right-16 w-36 h-36 bg-mint/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="w-12 h-12 rounded-2xl bg-white/[0.06] border border-white/10 mx-auto flex items-center justify-center text-mint mb-4">
        <svg viewBox="0 0 36 36" fill="none" class="w-7 h-7">
          <path d="M5 26L14 8L20 19L24 13L31 26H5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14 8L18 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </div>

      <span class="font-serif text-3xl text-white block mb-2">Singgah</span>
      <p class="font-sans text-xs text-mint uppercase tracking-widest font-semibold mb-6">
        Masuk untuk menyimpan rencana
      </p>

      <p class="font-sans text-sm text-text-2 mb-8 leading-relaxed">
        Masuk untuk menyinkronkan rencana perjalanan ke penyimpanan cloud, menyimpan destinasi favorit, dan membagikan tautan.
      </p>

      <div class="space-y-4">
        <a
          href="/api/v1/auth/google"
          class="w-full py-3.5 px-4 bg-white/10 hover:bg-white/15 border border-white/15 text-white font-sans font-semibold text-sm rounded-full flex items-center justify-center gap-3 transition-all hover:scale-[1.02]">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path
              fill="#4285F4"
              d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.02h3.86c2.26-2.09 3.68-5.17 3.68-9.12z"
            ></path>
            <path
              fill="#34A853"
              d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3.02c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.28v3.12C3.26 21.36 7.37 24 12 24z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.27 14.27c-.25-.72-.39-1.49-.39-2.27s.14-1.55.39-2.27V6.61H1.28C.46 8.23 0 10.06 0 12s.46 3.77 1.28 5.39l3.99-3.12z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.37 0 3.26 2.64 1.28 6.61l3.99 3.12c.95-2.85 3.6-4.98 6.73-4.98z"
            ></path>
          </svg>
          Masuk dengan Google
        </a>

        <!-- Akses Cepat Mode Uji Coba -->
        <a
          href="/api/v1/auth/demo-login"
          class="block text-xs font-sans text-mint hover:underline pt-2 font-medium">
          Masuk dengan Akun Tamu Demo (Mode Uji Coba)
        </a>
      </div>

      <div class="mt-8 pt-6 border-t border-white/8 text-[11px] text-text-3 leading-relaxed">
        Kami menghargai privasi dan anonimitas pengunjung. Baca selengkapnya di <a href="/privasi" class="underline text-white hover:text-mint">kebijakan privasi</a>.
      </div>
    </div>
  </div>
</BaseLayout>

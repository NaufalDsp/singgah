---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeasonStrip from '../../components/SeasonStrip.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { calculateYearSeasons } from '@singgah/scoring';
import fs from 'node:fs';
import path from 'node:path';

type MoodEntry = CollectionEntry<'moods'>;
type DestEntry = CollectionEntry<'destinations'>;

export async function getStaticPaths() {
  const moods = await getCollection('moods');
  return moods.map((entry: MoodEntry) => ({
    params: { slug: entry.data.id },
    props: { mood: entry },
  }));
}

interface Props {
  mood: MoodEntry;
}

const { mood } = Astro.props;
const allDestinations: DestEntry[] = await getCollection('destinations');
const matchingDestinations = allDestinations.filter((d) => d.data.moods.includes(mood.data.id));

interface DestinationCard {
  dest: DestEntry;
  yearSeasons: any[];
}

// Load climate data
const destinationCards: DestinationCard[] = matchingDestinations.map((dest) => {
  let yearSeasons: any[] = [];
  const climatePath = path.resolve(`../../data/climate/${dest.slug}.json`);
  if (fs.existsSync(climatePath)) {
    const climate = JSON.parse(fs.readFileSync(climatePath, 'utf-8'));
    yearSeasons = calculateYearSeasons(
      climate.months,
      dest.data.profile,
      dest.data.season_overrides,
    );
  }
  return { dest, yearSeasons };
});

const ratings: Record<string, string> = {
  'labuan-bajo': '4.9',
  'banda-neira': '4.9',
  'danau-toba': '4.8',
  'bromo': '4.8',
  'toraja': '4.8',
  'yogyakarta': '4.7',
};
---

<BaseLayout title={`${mood.data.name} — Singgah`}>
  <div class="max-w-container mx-auto px-4 md:px-8 py-20 w-full">
    <div class="max-w-3xl mb-14">
      <a
        href="/suasana"
        class="text-xs font-sans font-medium text-mint hover:underline mb-4 inline-flex items-center gap-1.5">
        ← Kembali ke daftar suasana
      </a>
      <div class="flex items-center gap-2 text-mint text-xs uppercase tracking-widest font-semibold mb-2">
        <span class="w-2 h-2 rounded-full bg-mint"></span>
        <span>KATEGORI SUASANA</span>
      </div>
      <h1 class="font-serif text-[clamp(2.5rem,5.5vw,5rem)] text-white leading-tight mb-4">
        {mood.data.name}
      </h1>
      <p class="font-sans text-base sm:text-lg text-text-2 leading-relaxed">
        {mood.data.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        destinationCards.map(({ dest, yearSeasons }) => (
          <article class="bg-[#081822] rounded-3xl border border-white/10 overflow-hidden flex flex-col justify-between group hover:border-mint/50 transition-all duration-300 shadow-xl hover:-translate-y-1">
            <div>
              <a
                href={`/destinasi/${dest.slug}`}
                class="block aspect-[16/10] overflow-hidden relative">
                <img
                  src={dest.data.hero.photo}
                  alt={dest.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#081822] via-[#081822]/30 to-transparent"></div>
                
                <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md border border-white/12 px-3 py-1 rounded-full text-[11px] font-semibold text-white">
                  {dest.data.region.island}
                </div>

                <div class="absolute top-4 right-4 bg-black/60 backdrop-blur-md border border-white/12 px-2.5 py-1 rounded-full text-xs font-bold text-star">
                  ★ {ratings[dest.slug] || '4.8'}
                </div>
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-text-3 font-medium mb-1.5">
                  <span class="text-white/60">
                    {dest.data.region.island}, {dest.data.region.province}
                  </span>
                  <span class="text-mint font-semibold">
                    {dest.data.typical_days.min}–{dest.data.typical_days.max} hari
                  </span>
                </div>

                <h2 class="font-serif text-2xl sm:text-3xl text-white mb-2 group-hover:text-mint transition-colors">
                  <a href={`/destinasi/${dest.slug}`}>
                    {dest.data.name}
                  </a>
                </h2>

                <p class="font-sans text-xs sm:text-sm text-text-2 line-clamp-3 leading-relaxed mb-6">
                  {dest.data.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-3 border-t border-white/8 bg-black/20">
              <span class="text-[10px] text-text-3 font-semibold uppercase tracking-wider block mb-2">
                Kalender Musim 12 Bulan
              </span>
              <SeasonStrip months={yearSeasons} mode="ringkas" destinationName={dest.data.name} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

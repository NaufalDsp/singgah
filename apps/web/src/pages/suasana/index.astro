---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type MoodEntry = CollectionEntry<'moods'>;
type DestEntry = CollectionEntry<'destinations'>;

const moods: MoodEntry[] = await getCollection('moods');
const destinations: DestEntry[] = await getCollection('destinations');

const optImg = (url: string, w = 640, q = 75) => {
  if (!url) return '';
  return url.includes('unsplash.com') ? `${url.split('?')[0]}?auto=format&fit=crop&w=${w}&q=${q}` : url;
};
---

<BaseLayout title="Jelajah Menurut Suasana — Singgah">
  <div class="max-w-container mx-auto px-4 md:px-8 py-20 w-full">
    <div class="max-w-3xl mb-14">
      <div class="flex items-center gap-2 text-mint text-xs uppercase tracking-widest font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-mint"></span>
        <span>RITME & LANSKAP PERJALANAN</span>
      </div>
      <h1 class="font-serif text-[clamp(2.5rem,5.5vw,5rem)] text-white leading-tight mb-4">
        Temukan suasana yang kamu cari
      </h1>
      <p class="font-sans text-base sm:text-lg text-text-2 leading-relaxed">
        Pilih tipe lanskap dan ritme perjalanan yang paling sesuai dengan jiwamu, mulai dari ketenangan pesisir pulau terpencil hingga kekayaan magis ritus desa adat.
      </p>
    </div>

    <!-- Grid Kartu Suasana Bento -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        moods.map((m) => {
          const moodId = m.data.id || m.id;
          const count = destinations.filter((d) => d.data.moods.includes(moodId)).length;
          return (
            <a
              href={`/suasana/${moodId}`}
              class="group relative h-80 rounded-3xl overflow-hidden border border-white/10 p-7 flex flex-col justify-between transition-all duration-500 hover:border-mint/60 hover:-translate-y-1.5 shadow-2xl block"
            >
              <img
                src={optImg(m.data.photo, 640)}
                alt={m.data.name}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#040E14] via-[#040E14]/40 to-transparent"></div>

              <div class="relative z-10 self-start bg-black/60 backdrop-blur-md border border-white/15 px-3.5 py-1 rounded-full text-xs font-semibold text-mint">
                {count} Destinasi Terkait
              </div>

              <div class="relative z-10">
                <h2 class="font-serif text-3xl text-white group-hover:text-mint transition-colors mb-2">
                  {m.data.name}
                </h2>
                <p class="font-sans text-xs sm:text-sm text-white/80 line-clamp-2 leading-relaxed">
                  {m.data.description}
                </p>
                <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-mint group-hover:translate-x-1 transition-transform">
                  <span>Lihat destinasi suasana ini</span>
                  <span>→</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

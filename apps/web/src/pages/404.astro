---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan — Singgah" transparentHeader={true}>
  <section class="not-found-hero tema-malam">
    <div class="not-found-content">
      <h1 class="not-found-title">Halaman ini tidak ketemu.</h1>
      <p class="not-found-desc">
        Tautan yang kamu tuju mungkin sudah dipindahkan atau belum pernah ada.
      </p>
      <a href="/" class="btn-utama">Kembali ke beranda</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--margin-x);
    text-align: center;
  }

  .not-found-content {
    max-width: 540px;
  }

  .not-found-title {
    font-size: var(--t-display);
    line-height: 1.05;
    margin-bottom: 20px;
  }

  .not-found-desc {
    font-size: var(--t-lead);
    color: var(--text-2);
    margin-bottom: 32px;
  }
</style>

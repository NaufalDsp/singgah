    /* Animasi Halus Icon Dropdown Berbalik Arah (180deg) Saat Diklik / Fokus */
    .dropdown-anim-chevron {
      transform-origin: center;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
      display: inline-block;
      will-change: transform;
    }

    .dropdown-field-group:hover .dropdown-anim-chevron {
      color: #2DD4BF;
    }

    /* Ketika select diklik / dibuka / fokus, icon chevron berbalik arah 180 derajat secara mulus */
    .dropdown-field-group:focus-within .dropdown-anim-chevron,
    .dropdown-field-group.is-open .dropdown-anim-chevron {
      color: #2DD4BF !important;
      transform: rotate(180deg);
    }

    /* Animasi Soundwave Ritme & Lanskap */
    @keyframes rhythmBar1 {
      0%, 100% { height: 4px; }
      50% { height: 14px; }
    }
    @keyframes rhythmBar2 {
      0%, 100% { height: 12px; }
      50% { height: 5px; }
    }
    @keyframes rhythmBar3 {
      0%, 100% { height: 6px; }
      50% { height: 13px; }
    }
    @keyframes rhythmBar4 {
      0%, 100% { height: 10px; }
      50% { height: 4px; }
    }

    .animate-rhythm-1 {
      animation: rhythmBar1 1.2s ease-in-out infinite;
    }
    .animate-rhythm-2 {
      animation: rhythmBar2 1.0s ease-in-out infinite 0.2s;
    }
    .animate-rhythm-3 {
      animation: rhythmBar3 1.4s ease-in-out infinite 0.4s;
    }
    .animate-rhythm-4 {
      animation: rhythmBar4 0.9s ease-in-out infinite 0.1s;
    }


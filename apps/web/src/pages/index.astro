---
import BaseLayout from '../layouts/BaseLayout.astro';

const months = [
  'Januari',
  'Februari',
  'Maret',
  'April',
  'Mei',
  'Juni',
  'Juli',
  'Agustus',
  'September',
  'Oktober',
  'November',
  'Desember',
];
const currentMonthIndex = new Date().getMonth();
const currentMonthName = months[currentMonthIndex];
---

<BaseLayout title="Singgah — Panduan Destinasi Nusantara" transparentHeader={true}>
  <!-- Hero Section (Berdasarkan spesifikasi DESIGN.md Bagian 7) -->
  <section class="hero tema-malam" aria-labelledby="hero-judul">
    <!-- Foto Asli Penuh Layar dengan Scrim Terhitung -->
    <div class="hero__media">
      <img
        src="https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&w=1920&q=80"
        alt="Tebing karst dan pantai berpasir putih di Nusa Penida saat laut surut"
        class="hero__img"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__content">
      <div class="hero__headline-wrap">
        <h1 id="hero-judul" class="hero__judul">
          <span class="baris baris--1">Tempat yang pantas</span>
          <span class="baris baris--2">disinggahi</span>
        </h1>
        <p class="hero__lead">
          Panduan destinasi Nusantara dengan kalender musim dari data cuaca 30 tahun.
        </p>
        <a class="hero__secondary-link" href="/destinasi">Jelajahi semua destinasi</a>
      </div>

      <figure class="hero__keterangan" aria-label="Kredit Foto">
        <figcaption>
          <em>Nusa Penida, Bali</em><br />
          Foto: <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">I Putu</a> di
          Unsplash
        </figcaption>
      </figure>
    </div>

    <!-- Panel Rencana Cepat Solid di Dasar Hero -->
    <div class="quickplan-container">
      <form class="quickplan-panel" method="get" action="/rencana/saran">
        <div class="quickplan-field">
          <label for="qp-tujuan">Tujuan</label>
          <select id="qp-tujuan" name="tujuan">
            <option value="">Belum tahu, sarankan</option>
            <option value="labuan-bajo">Labuan Bajo</option>
            <option value="bromo">Bromo</option>
            <option value="banda-neira">Banda Neira</option>
            <option value="yogyakarta">Yogyakarta</option>
          </select>
        </div>

        <div class="quickplan-divider" aria-hidden="true"></div>

        <div class="quickplan-field">
          <label for="qp-bulan">Bulan</label>
          <select id="qp-bulan" name="bulan">
            {
              months.map((m, idx) => (
                <option value={idx + 1} selected={idx === currentMonthIndex}>
                  {m}
                </option>
              ))
            }
          </select>
        </div>

        <div class="quickplan-divider" aria-hidden="true"></div>

        <div class="quickplan-field">
          <label for="qp-lama">Lama Perjalanan</label>
          <select id="qp-lama" name="lama">
            <option value="3">3 hari</option>
            <option value="4" selected>4 hari</option>
            <option value="5">5 hari</option>
            <option value="7">7 hari</option>
          </select>
        </div>

        <div class="quickplan-divider" aria-hidden="true"></div>

        <div class="quickplan-field">
          <label for="qp-suasana">Suasana</label>
          <select id="qp-suasana" name="suasana">
            <option value="apa-saja" selected>Apa saja</option>
            <option value="pantai">Pantai dan laut</option>
            <option value="gunung">Gunung dan kabut</option>
            <option value="budaya">Budaya dan desa</option>
          </select>
        </div>

        <button type="submit" class="quickplan-submit"> Lihat saran </button>
      </form>
    </div>
  </section>

  <!-- Bagian Pengantar Fondasi (Fase 0) -->
  <section class="section-intro">
    <div class="intro-container">
      <div class="intro-badge">Fase 0 Selesai — Fondasi Sistem</div>
      <h2 class="intro-heading">Dibuat dari angka nyata, tanpa klise.</h2>
      <p class="intro-text">
        Singgah sedang menyiapkan pipeline data iklim 30 tahun (Open-Meteo 1994–2023) untuk 12
        destinasi pilihan. Tanpa iklan, tanpa tautan afiliasi, dan tanpa klaim kosong.
      </p>

      <div class="intro-status-box">
        <div class="status-item">
          <span class="status-label">API Health Check</span>
          <a href="/api/v1/health" class="status-link">Periksa /api/v1/health</a>
        </div>
        <div class="status-item">
          <span class="status-label">Arsitektur</span>
          <span>Astro (Static) + Cloudflare Workers (Hono)</span>
        </div>
        <div class="status-item">
          <span class="status-label">Bulan Berjalan</span>
          <span>{currentMonthName} (Deteksi Dinamis)</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 100px;
    background-color: #091218;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(9, 18, 24, 0.55) 0%,
        rgba(9, 18, 24, 0.2) 25%,
        transparent 50%
      ),
      linear-gradient(to top, rgba(9, 18, 24, 0.82) 0%, rgba(9, 18, 24, 0.45) 45%, transparent 75%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
    padding: 40px var(--margin-x) 100px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
  }

  .hero__headline-wrap {
    max-width: 900px;
  }

  .hero__judul {
    font-size: var(--t-hero);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 24px;
  }

  .hero__judul .baris {
    display: block;
  }

  .hero__judul .baris--2 {
    margin-left: 14%;
  }

  @media (max-width: 767px) {
    .hero__judul .baris--2 {
      margin-left: 8vw;
    }
  }

  .hero__lead {
    font-size: var(--t-lead);
    color: #e8eeef;
    max-width: 44ch;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .hero__secondary-link {
    display: inline-block;
    color: #ffffff;
    font-size: var(--t-ui);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
  }

  .hero__keterangan {
    align-self: flex-end;
    margin: 0;
    text-align: right;
    color: #cbd5d5;
    font-size: var(--t-small);
    line-height: 1.4;
  }

  .hero__keterangan em {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    color: #ffffff;
  }

  .hero__keterangan a {
    color: #cbd5d5;
  }

  /* Quick Plan Panel Solid */
  .quickplan-container {
    position: relative;
    z-index: 10;
    max-width: 1160px;
    width: calc(100% - 2 * var(--margin-x));
    margin: 0 auto -40px;
  }

  .quickplan-panel {
    background: var(--surface);
    color: var(--text);
    border-radius: var(--r-panel);
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .quickplan-panel {
      flex-direction: row;
      align-items: stretch;
      height: 80px;
    }
  }

  .quickplan-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 16px 20px;
  }

  .quickplan-field label {
    font-size: var(--t-small);
    color: var(--text-3);
    margin-bottom: 4px;
    font-weight: 500;
  }

  .quickplan-field select {
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--t-ui);
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    outline: none;
  }

  .quickplan-divider {
    width: 1px;
    background-color: var(--line);
    margin: 12px 0;
  }

  @media (max-width: 1023px) {
    .quickplan-divider {
      width: 100%;
      height: 1px;
      margin: 0;
    }
  }

  .quickplan-submit {
    background: var(--cta-bg);
    color: var(--cta-text);
    font-family: var(--font-sans);
    font-size: var(--t-ui);
    font-weight: 500;
    border: none;
    padding: 0 32px;
    min-height: 56px;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .quickplan-submit:hover {
    background: var(--cta-hover);
  }

  /* Section Intro */
  .section-intro {
    padding: calc(var(--section-y) + 40px) var(--margin-x) var(--section-y);
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
  }

  .intro-container {
    max-width: 760px;
  }

  .intro-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-ui);
    font-size: var(--t-small);
    color: var(--text-2);
    margin-bottom: 20px;
  }

  .intro-heading {
    font-size: var(--t-h2);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .intro-text {
    font-size: var(--t-lead);
    color: var(--text-2);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .intro-status-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
  }

  @media (min-width: 640px) {
    .intro-status-box {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .status-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--t-small);
  }

  .status-label {
    color: var(--text-3);
    font-weight: 500;
  }

  .status-link {
    color: var(--link);
    font-weight: 500;
  }
</style>

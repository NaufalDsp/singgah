---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonStrip from '../components/SeasonStrip.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { calculateYearSeasons } from '@singgah/scoring';
import fs from 'node:fs';
import path from 'node:path';

type DestEntry = CollectionEntry<'destinations'>;
type MoodEntry = CollectionEntry<'moods'>;
type ArticleEntry = CollectionEntry<'articles'>;

// Ambil seluruh koleksi konten
const destinations: DestEntry[] = await getCollection('destinations');
const articles: ArticleEntry[] = (await getCollection('articles')).slice(0, 3);
const moods: MoodEntry[] = await getCollection('moods');

// Load data iklim 30 tahun per destinasi
const climateDataMap: Record<string, any> = {};
for (const dest of destinations) {
  const filePath = path.resolve(`../../data/climate/${dest.slug}.json`);
  if (fs.existsSync(filePath)) {
    climateDataMap[dest.slug] = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  }
}

// Bulan berjalan (1-12)
const currentMonth = new Date().getMonth() + 1;
const monthNamesFull = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember',
];
const currentMonthName = monthNamesFull[currentMonth - 1];

// Hitung skor kelayakan musim bulan ini untuk setiap destinasi
const scoredDestinations = destinations.map((dest: DestEntry) => {
  const climate = climateDataMap[dest.slug];
  const yearSeasons = climate
    ? calculateYearSeasons(climate.months, dest.data.profile, dest.data.season_overrides)
    : [];
  const currentSeason = yearSeasons.find((s) => s.month === currentMonth);
  return {
    dest,
    climate,
    yearSeasons,
    currentSeason,
    score: currentSeason?.score ?? 0,
    level: currentSeason?.level ?? 'cukup',
  };
}).sort((a: any, b: any) => b.score - a.score);

const topDestination = scoredDestinations[0];
const otherGoodDestinations = scoredDestinations.slice(1, 5);

// Deterministic season reason generator
function generateReason(season: any, typical: { min: number; max: number }) {
  if (!season) return `Ideal untuk kunjungan ${typical.min}–${typical.max} hari.`;
  if (season.is_override && season.override_reason) {
    return `${season.override_reason}. Durasi ideal ${typical.min}–${typical.max} hari.`;
  }
  let desc = 'Cukup cerah';
  if (season.wet_days <= 5 && season.precip_mm <= 70) desc = 'Kering, cerah optimal & minim hujan';
  else if (season.wet_days <= 9) desc = 'Cuaca bersahabat untuk jelajah luar ruang';
  else if (season.wet_days >= 18) desc = 'Musim basah dengan curah hujan tinggi';
  return `${desc}, perkiraan ${Math.round(season.wet_days)} hari hujan (${Math.round(season.precip_mm)} mm). Rekomendasi ${typical.min}–${typical.max} hari.`;
}

// Mock rating untuk visual Wanderlust
const ratings: Record<string, string> = {
  'labuan-bajo': '4.9',
  'banda-neira': '4.9',
  'danau-toba': '4.8',
  'bromo': '4.8',
  'toraja': '4.8',
  'yogyakarta': '4.7',
};
---

<BaseLayout title="Singgah — Panduan Destinasi Nusantara" transparentHeader={true}>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION (SESUAI REFERENSI DESAIN WANDERLUST)                      -->
  <!-- ========================================================================= -->
  <section class="relative min-h-screen flex flex-col justify-between pt-28 pb-16 overflow-hidden bg-[#041017]" aria-labelledby="hero-title">
    <!-- Cinematic High-Res Nature Background dengan Scrim Terukur (Jelas & Terlihat Indah) -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1516690561799-46d8f74f9abf?auto=format&fit=crop&w=2560&q=85"
        alt="Gugusan kepulauan karst Raja Ampat di atas perairan pirus jernih Nusantara"
        class="w-full h-full object-cover object-center scale-[1.02] transition-transform duration-1000 ease-out"
        fetchpriority="high"
      />
      <!-- Scrim Terukur: Jelas & Kontras Alami, Lanskap Pulau dan Air Terlihat Nyata -->
      <!-- Gradien Kiri (untuk keterbacaan teks headline) -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#041017]/80 via-[#041017]/35 to-transparent"></div>
      <!-- Gradien Bawah (transisi halus ke konten bawah) -->
      <div class="absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-[#041017] via-[#041017]/60 to-transparent"></div>
      <!-- Gradien Atas (kontras navbar) -->
      <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-[#041017]/70 to-transparent"></div>
    </div>

    <!-- Dotted Flight Trail & Island Marker (Sesuai Referensi Wanderlust) -->
    <div class="absolute inset-0 pointer-events-none z-10 hidden lg:block overflow-hidden">
      <svg class="w-full h-full" viewBox="0 0 1440 850" fill="none">
        <path
          d="M680 180 C 720 230, 780 340, 640 510 C 600 560, 650 630, 840 640"
          stroke="rgba(255, 255, 255, 0.4)"
          stroke-width="1.8"
          stroke-dasharray="6 7"
          stroke-linecap="round"
        />
        <!-- Airplane Icon on Path -->
        <g transform="translate(675, 182) rotate(45)">
          <path d="M0 0 L14 7 L7 8 L6 13 L3 9 L-2 11 L0 0Z" fill="#5EEAD4" opacity="0.9" />
        </g>
        <!-- Glowing Location Pin on Island -->
        <g transform="translate(635, 485)">
          <circle cx="12" cy="12" r="16" fill="rgba(45, 212, 191, 0.2)" class="animate-ping" />
          <circle cx="12" cy="12" r="12" fill="#2DD4BF" />
          <circle cx="12" cy="12" r="5" fill="#04141A" />
        </g>
      </svg>
    </div>

    <!-- Container Konten Atas Hero (Headline Kiri & Floating Card Kanan) -->
    <div class="relative z-20 max-w-container mx-auto px-4 md:px-8 w-full mt-6 mb-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Kolom Kiri: Editorial Headline & Dual CTA (7 Kolom) -->
        <div class="lg:col-span-7 flex flex-col items-start pt-6">
          <!-- Eyebrow Badge dengan Garis Tipis -->
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-[2px] bg-mint rounded-full"></span>
            <span class="text-xs uppercase tracking-[0.25em] text-mint font-semibold">NUSANTARA MENANTI</span>
          </div>

          <!-- Headline Editorial Mewah (Playfair Display / Serif) -->
          <h1 id="hero-title" class="font-serif text-[clamp(2.8rem,6.8vw,6.4rem)] leading-[0.96] text-white tracking-tight mb-7">
            Adventures <br />
            That Stay <br />
            With You
          </h1>

          <!-- Deskripsi Elegan -->
          <p class="font-sans text-[clamp(1rem,1.35vw,1.2rem)] text-white/85 max-w-[48ch] leading-relaxed mb-9 font-normal">
            Temukan keelokan tersembunyi pulau-pulau Nusantara, momen musim terbaik yang presisi, dan kenangan abadi — dikurasi dari data iklim 30 tahun.
          </p>

          <!-- Dual Call To Actions -->
          <div class="flex flex-wrap items-center gap-5">
            <a href="/destinasi" class="btn-primary group">
              <span>Jelajahi Destinasi</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none">
                <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            <a href="/catatan" class="btn-glass group">
              <span class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-mint group-hover:bg-mint group-hover:text-black transition-colors">
                <svg class="w-3.5 h-3.5 fill-current ml-0.5" viewBox="0 0 16 16">
                  <path d="M4 3.5L13 8L4 12.5V3.5Z" />
                </svg>
              </span>
              <span>Catatan Lapangan</span>
            </a>
          </div>
        </div>

        <!-- Kolom Kanan: Floating Booking Planner Card (5 Kolom) - Sesuai Referensi Gambar -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div
            class="w-full max-w-[420px] rounded-[28px] p-6 sm:p-7 shadow-2xl relative overflow-hidden"
            style="background-color: #121B1E; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.65);"
          >
            <!-- Card Header: Where to next? -->
            <div class="mb-5">
              <h2 class="font-sans font-bold text-2xl text-white tracking-tight leading-tight">
                Where to next?
              </h2>
              <p class="font-sans text-xs text-white/50 mt-1 font-normal">
                Find your perfect escape
              </p>
            </div>

            <!-- Tab Pilihan Persis Sesuai Referensi (Flights, Hotels, Experiences) - Tanpa Blok Abu-abu -->
            <div class="grid grid-cols-3 gap-2 mb-5 text-center">
              <button
                type="button"
                class="hero-tab-btn flex flex-col items-center group cursor-pointer transition-colors"
                style="background: transparent !important; border: none !important; box-shadow: none !important;"
              >
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
                </svg>
                <span class="text-xs font-semibold text-white mt-1.5">Flights</span>
                <span class="w-6 h-[2.5px] bg-[#2DD4BF] rounded-full mt-1.5 shadow-[0_0_8px_rgba(45,212,191,0.6)]"></span>
              </button>

              <button
                type="button"
                class="hero-tab-btn flex flex-col items-center group cursor-pointer text-white/45 hover:text-white transition-colors"
                style="background: transparent !important; border: none !important; box-shadow: none !important;"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span class="text-xs font-medium mt-1.5">Hotels</span>
              </button>

              <button
                type="button"
                class="hero-tab-btn flex flex-col items-center group cursor-pointer text-white/45 hover:text-white transition-colors"
                style="background: transparent !important; border: none !important; box-shadow: none !important;"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <span class="text-xs font-medium mt-1.5">Experiences</span>
              </button>
            </div>

            <!-- Form Rencana Interaktif -->
            <form action="/rencana/saran" method="get" class="space-y-3">
              <!-- Route Container (From / To dengan Swap Button Sesuai Referensi) -->
              <div
                class="rounded-2xl p-4 transition-all duration-300"
                style="background-color: #162227; border: 1px solid rgba(255, 255, 255, 0.08);"
              >
                <!-- Baris Asal (From) -->
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                  <div>
                    <span class="text-[10px] text-white/45 uppercase tracking-wider block font-bold">FROM</span>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] flex-shrink-0"></span>
                      <span class="text-xs sm:text-sm font-semibold text-white tracking-tight">Jakarta (CGK)</span>
                    </div>
                  </div>
                  <!-- Circular Swap Icon Button Sesuai Referensi -->
                  <button
                    type="button"
                    title="Tukar rute"
                    class="w-8 h-8 rounded-xl bg-[#202C31] hover:bg-mint hover:text-[#0C1E24] flex items-center justify-center text-white/70 transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
                    style="border: 1px solid rgba(255, 255, 255, 0.1);"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/>
                    </svg>
                  </button>
                </div>

                <!-- Baris Tujuan (To) - Tanpa Garis Border Tipis Bawaan Browser -->
                <div class="pt-3">
                  <label for="qp-hero-tujuan" class="text-[10px] text-white/45 uppercase tracking-wider block font-bold mb-0.5">TO</label>
                  <div class="flex items-center gap-2 mt-0.5 relative">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] flex-shrink-0"></span>
                    <div class="relative flex-1 min-w-0">
                      <select
                        id="qp-hero-tujuan"
                        name="tujuan"
                        class="hero-select-clean w-full text-xs sm:text-sm font-semibold text-white cursor-pointer pr-6 truncate"
                        style="background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; appearance: none !important; padding: 0 !important; color-scheme: dark !important;"
                      >
                        <option value="" style="background-color: #121B1E; color: #FFFFFF;">Pilih Destinasi (Rekomendasi AI)</option>
                        {destinations.map((d) => (
                          <option value={d.slug} style="background-color: #121B1E; color: #FFFFFF;">
                            {d.data.name}, {d.data.region.island}
                          </option>
                        ))}
                      </select>
                      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center text-white/40">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Baris Dates & Travelers Bersebelahan Sesuai Referensi -->
              <div class="grid grid-cols-2 gap-2.5">
                <!-- Box Dates - Tanpa Garis Border Tipis Bawaan Browser -->
                <div
                  class="rounded-2xl p-3.5 hover:border-white/20 transition-all duration-300"
                  style="background-color: #162227; border: 1px solid rgba(255, 255, 255, 0.08);"
                >
                  <div class="flex items-center gap-1.5 mb-1">
                    <svg class="w-3.5 h-3.5 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <label for="qp-hero-bulan" class="text-[10px] text-white/45 uppercase tracking-wider font-bold">DATES</label>
                  </div>
                  <div class="relative mt-1">
                    <select
                      id="qp-hero-bulan"
                      name="bulan"
                      class="hero-select-clean w-full text-xs sm:text-sm font-semibold text-white cursor-pointer pr-5"
                      style="background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; appearance: none !important; padding: 0 !important; color-scheme: dark !important;"
                    >
                      {monthNamesFull.map((m, idx) => (
                        <option value={idx + 1} selected={idx + 1 === currentMonth} style="background-color: #121B1E; color: #FFFFFF;">
                          {m}
                        </option>
                      ))}
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center text-white/40">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- Box Travelers / Durasi - Tanpa Garis Border Tipis Bawaan Browser -->
                <div
                  class="rounded-2xl p-3.5 hover:border-white/20 transition-all duration-300"
                  style="background-color: #162227; border: 1px solid rgba(255, 255, 255, 0.08);"
                >
                  <div class="flex items-center gap-1.5 mb-1">
                    <svg class="w-3.5 h-3.5 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <label for="qp-hero-lama" class="text-[10px] text-white/45 uppercase tracking-wider font-bold">TRAVELERS</label>
                  </div>
                  <div class="relative mt-1">
                    <select
                      id="qp-hero-lama"
                      name="lama"
                      class="hero-select-clean w-full text-xs sm:text-sm font-semibold text-white cursor-pointer pr-5"
                      style="background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; appearance: none !important; padding: 0 !important; color-scheme: dark !important;"
                    >
                      <option value="2" style="background-color: #121B1E; color: #FFFFFF;">2 Adults • Weekend</option>
                      <option value="3" style="background-color: #121B1E; color: #FFFFFF;">2 Adults • 3 Hari</option>
                      <option value="4" selected style="background-color: #121B1E; color: #FFFFFF;">2 Adults • 4 Hari</option>
                      <option value="5" style="background-color: #121B1E; color: #FFFFFF;">2 Adults • 5 Hari</option>
                      <option value="7" style="background-color: #121B1E; color: #FFFFFF;">2 Adults • 7 Hari</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center text-white/40">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Submit CTA Button Vibrant Mint Pill Sesuai Referensi -->
              <button
                type="submit"
                class="w-full mt-4 py-3.5 px-6 rounded-2xl font-bold text-sm sm:text-base tracking-tight flex items-center justify-center gap-2 hover:brightness-105 active:scale-[0.99] transition-all duration-200 cursor-pointer shadow-[0_8px_24px_rgba(94,234,212,0.35)] hover:shadow-[0_12px_32px_rgba(94,234,212,0.5)] group"
                style="background-color: #5EEAD4; color: #0C1E24; border: none !important;"
              >
                <span>Search Flights</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none">
                  <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Bagian Bawah Hero: Carousel Destinasi Populer & Feature Glass Bar -->
    <div class="relative z-20 max-w-container mx-auto px-4 md:px-8 w-full mt-auto pt-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <!-- Kiri (7 Kolom): Destinasi Populer Strip Slider -->
        <div class="lg:col-span-7">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <h3 class="font-sans font-bold text-base text-white">Destinasi Populer</h3>
              <a href="/destinasi" class="text-xs text-mint hover:underline font-medium">Lihat semua</a>
            </div>
            <!-- Arrow Controls -->
            <div class="flex items-center gap-2">
              <button type="button" aria-label="Sebelumnya" class="w-8 h-8 rounded-full bg-white/[0.08] border border-white/12 flex items-center justify-center text-white/70 hover:text-white hover:bg-white/15 transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
                  <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button type="button" aria-label="Berikutnya" class="w-8 h-8 rounded-full bg-white/[0.08] border border-white/12 flex items-center justify-center text-white/70 hover:text-white hover:bg-white/15 transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
                  <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Cards Horizontal Scroll Row -->
          <div class="flex gap-3.5 overflow-x-auto no-scrollbar pb-2">
            {destinations.slice(0, 4).map((dest) => (
              <a
                href={`/destinasi/${dest.slug}`}
                class="group relative flex-shrink-0 w-36 sm:w-44 aspect-[4/3] rounded-2xl overflow-hidden border border-white/12 bg-black/40 shadow-lg hover:border-mint/50 transition-all duration-300"
              >
                <img
                  src={dest.data.hero.photo}
                  alt={dest.data.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-end justify-between">
                  <div>
                    <h4 class="font-sans font-bold text-xs sm:text-sm text-white group-hover:text-mint transition-colors truncate">
                      {dest.data.name}
                    </h4>
                    <p class="font-sans text-[10px] text-white/70 truncate">{dest.data.region.island}</p>
                  </div>
                  <div class="flex items-center gap-1 text-[11px] font-bold text-star bg-black/50 backdrop-blur-md px-1.5 py-0.5 rounded-md">
                    <span>★</span>
                    <span class="text-white text-[10px]">{ratings[dest.slug] || '4.8'}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>


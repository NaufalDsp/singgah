  <script>
    function setupSelectDropdownAnimations() {
      const fieldGroups = document.querySelectorAll('.dropdown-field-group');
      fieldGroups.forEach((group) => {
        const select = group.querySelector('select');
        if (!select) return;

        select.addEventListener('focus', () => {
          group.classList.add('is-open');
        });

        select.addEventListener('blur', () => {
          group.classList.remove('is-open');
        });

        select.addEventListener('change', () => {
          group.classList.remove('is-open');
        });
      });
    }

    function setupMoodFilters() {
      const filterButtons = document.querySelectorAll('.mood-filter-btn');
      const moodCards = document.querySelectorAll('.mood-card');

      if (!filterButtons.length || !moodCards.length) return;

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter') || 'all';

          // Update active button styling
          filterButtons.forEach((b) => {
            const isActive = b === btn;
            const dot = b.querySelector('.filter-dot');
            if (isActive) {
              b.classList.remove('bg-white/[0.06]', 'text-white/80', 'border-white/12');
              b.classList.add('bg-mint', 'text-[#04141A]', 'border-mint', 'font-bold', 'shadow-[0_0_20px_rgba(45,212,191,0.35)]');
              if (dot) {
                dot.classList.remove('bg-mint');
                dot.classList.add('bg-[#04141A]');
              }
            } else {
              b.classList.remove('bg-mint', 'text-[#04141A]', 'border-mint', 'font-bold', 'shadow-[0_0_20px_rgba(45,212,191,0.35)]');
              b.classList.add('bg-white/[0.06]', 'text-white/80', 'border-white/12');
              if (dot) {
                dot.classList.remove('bg-[#04141A]');
                dot.classList.add('bg-mint');
              }
            }
          });

          // Transition mood cards
          moodCards.forEach((card) => {
            const cardMood = card.getAttribute('data-mood-card');
            const htmlCard = card as HTMLElement;
            if (filter === 'all' || cardMood === filter || cardMood === 'adaptive') {
              htmlCard.style.opacity = '1';
              htmlCard.style.filter = 'none';
              htmlCard.style.transform = 'scale(1)';
              htmlCard.style.pointerEvents = 'auto';
              if (cardMood === filter) {
                card.classList.add('ring-2', 'ring-mint', 'shadow-[0_0_35px_rgba(45,212,191,0.4)]');
              } else {
                card.classList.remove('ring-2', 'ring-mint', 'shadow-[0_0_35px_rgba(45,212,191,0.4)]');
              }
            } else {
              htmlCard.style.opacity = '0.2';
              htmlCard.style.filter = 'grayscale(0.7) blur(0.5px)';
              htmlCard.style.transform = 'scale(0.97)';
              htmlCard.style.pointerEvents = 'none';
              card.classList.remove('ring-2', 'ring-mint', 'shadow-[0_0_35px_rgba(45,212,191,0.4)]');
            }
          });
        });
      });
    }

    setupSelectDropdownAnimations();
    setupMoodFilters();
    document.addEventListener('astro:page-load', () => {
      setupSelectDropdownAnimations();
      setupMoodFilters();
    });
  </script>
</BaseLayout>
